{
  // Static site on Workers. The script only handles /api/* (the Broccoli Bot);
  // every other path is served straight from the files.
  "name": "irreverent-engineering",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-05",

  "ai": { "binding": "AI" },

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  "routes": [
    { "pattern": "irreverent.engineering", "custom_domain": true },
    { "pattern": "www.irreverent.engineering", "custom_domain": true }
  ]
}
